# ─────────────────────────────────────────────────────────────────────────────
#  jobX — Backend environment variables
#  Copy this file to .env and fill in your values.
#  Never commit the real .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
# Get from: Atlas dashboard → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://gauryosborn:gaury1234@cluster0.t80nv87.mongodb.net/?appName=Cluster0
MONGODB_DB=resumebuilder
MONGODB_COLLECTION=resumes

# ── Groq (via OpenAI-compatible SDK) ─────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=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
# Groq OpenAI-compatible base URL (don't change unless Groq moves it)
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Primary model  — meta-llama/llama-4-scout-17b-16e-instruct is the ~120B
# parameter Llama 4 Scout model (109B total / 17B active MoE) available on Groq.
# Other options on Groq (as of 2025):
#   llama-3.3-70b-versatile          (fast 70B)
#   llama-3.1-8b-instant             (fastest, smallest)
#   deepseek-r1-distill-llama-70b    (reasoning-tuned)
#   qwen-qvq-72b-preview             (vision-capable)
GROQ_MODEL=openai/gpt-oss-120b

# Fallback model used when the primary is unavailable or rate-limited
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# Comma-separated list of allowed CORS origins (your frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
