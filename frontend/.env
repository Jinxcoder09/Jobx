# ─────────────────────────────────────────────────────────────────────────────
#  jobX — Frontend environment variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (include the protocol, no trailing slash).
# In development the Vite proxy handles /api, so you can leave this empty.
# In production set this to where your FastAPI server is deployed.
VITE_API_URL=http://localhost:3001
